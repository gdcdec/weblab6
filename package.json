{
  "name": "web-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "husky": "husky",
    "lint:back": "eslint --ext .ts 'backend/src'",
    "lint:back:fix": "eslint --fix --ext .ts 'backend/src'",
    "check:back": "prettier --check 'backend/src/**/*.ts'",
    "format:back": "prettier --write 'backend/src/**/*.ts'",
    "lint:front": "eslint --ext .ts,.tsx 'frontend/src'",
    "lint:front:fix": "eslint --fix --ext .ts,.tsx 'frontend/src'",
    "check:front": "prettier --check 'frontend/src/**/*.{ts,tsx,scss}'",
    "format:front": "prettier --write 'frontend/src/**/*.{ts,tsx,scss}'",
    "clean": "rm -rf node_modules/ package-lock.json",
    "clean:back": "cd backend/ && npm run clean",
    "clean:front": "cd frontend/ && yarn clean",
    "clean:all": "npm run clean && npm run clean:back && npm run clean:front",
    "build:back": "cd backend/ && npm install",
    "build:front": "cd frontend/ && yarn install",
    "build:all": "npm install && npm run build:back && npm run build:front"
  },
  "keywords": [],
  "author": "Dobby",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.56.1"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx,scss}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
